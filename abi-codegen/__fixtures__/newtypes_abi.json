{
  "schema_version": "wasm-abi/1",
  "types": {
    "FolderId": {
      "kind": "alias",
      "target": {
        "kind": "string"
      }
    },
    "ContextId": {
      "kind": "alias",
      "target": {
        "kind": "string"
      }
    },
    "Height": {
      "kind": "alias",
      "target": {
        "kind": "u64"
      }
    },
    "Ratio": {
      "kind": "alias",
      "target": {
        "kind": "f64"
      }
    },
    "Flag": {
      "kind": "alias",
      "target": {
        "kind": "bool"
      }
    },
    "Hash32": {
      "kind": "alias",
      "target": {
        "kind": "bytes",
        "size": 32
      }
    },
    "Digest": {
      "kind": "alias",
      "target": {
        "$ref": "Hash32"
      }
    },
    "Tags": {
      "kind": "alias",
      "target": {
        "kind": "list",
        "items": {
          "kind": "string"
        }
      }
    },
    "Index": {
      "kind": "alias",
      "target": {
        "kind": "map",
        "key": {
          "kind": "string"
        },
        "value": {
          "kind": "string"
        }
      }
    },
    "AliasOfFolderId": {
      "kind": "alias",
      "target": {
        "$ref": "FolderId"
      }
    },
    "Role": {
      "kind": "variant",
      "variants": [
        {
          "name": "Viewer"
        },
        {
          "name": "Editor"
        }
      ]
    },
    "AliasOfRecord": {
      "kind": "alias",
      "target": {
        "$ref": "FolderEntry"
      }
    },
    "Action": {
      "kind": "variant",
      "variants": [
        {
          "name": "Noop"
        },
        {
          "name": "Rename",
          "payload": {
            "kind": "string"
          }
        }
      ]
    },
    "Command": {
      "kind": "variant",
      "variants": [
        {
          "name": "Cancel"
        },
        {
          "name": "Store",
          "payload": {
            "$ref": "Digest"
          }
        },
        {
          "name": "Scores",
          "payload": {
            "kind": "list",
            "items": {
              "kind": "u32"
            }
          }
        }
      ]
    },
    "AliasOfCommand": {
      "kind": "alias",
      "target": {
        "$ref": "Command"
      }
    },
    "FolderEntry": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "$ref": "FolderId"
          }
        },
        {
          "name": "member",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "height",
          "type": {
            "$ref": "Height"
          }
        },
        {
          "name": "role",
          "type": {
            "$ref": "Role"
          }
        }
      ]
    },
    "Sha256Hex": {
      "kind": "alias",
      "target": {
        "kind": "string"
      },
      "pattern": "^[0-9a-f]{64}$"
    },
    "RoutePath": {
      "kind": "alias",
      "target": {
        "kind": "string"
      },
      "pattern": "^/[a-z]+(/[a-z]+)*$"
    },
    "OddHeight": {
      "kind": "alias",
      "target": {
        "kind": "u64"
      },
      "pattern": "^[0-9]+$"
    }
  },
  "methods": [
    {
      "name": "get_folder",
      "params": [
        {
          "name": "id",
          "type": {
            "$ref": "FolderId"
          }
        }
      ],
      "returns": {
        "$ref": "FolderEntry"
      }
    },
    {
      "name": "bind_context",
      "params": [
        {
          "name": "folder_id",
          "type": {
            "$ref": "FolderId"
          }
        },
        {
          "name": "context_id",
          "type": {
            "$ref": "ContextId"
          }
        }
      ]
    },
    {
      "name": "current_height",
      "params": [],
      "returns": {
        "$ref": "Height"
      }
    },
    {
      "name": "reset_index",
      "params": []
    },
    {
      "name": "dispatch_action",
      "params": [
        {
          "name": "action",
          "type": {
            "$ref": "Action"
          }
        }
      ]
    },
    {
      "name": "store_hash",
      "params": [
        {
          "name": "hash",
          "type": {
            "$ref": "Hash32"
          }
        }
      ]
    },
    {
      "name": "rename_folder",
      "params": [
        {
          "name": "id",
          "type": {
            "$ref": "FolderId"
          }
        }
      ]
    },
    {
      "name": "tag_hash",
      "params": [
        {
          "name": "hash",
          "type": {
            "$ref": "Hash32"
          }
        },
        {
          "name": "label",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    {
      "name": "run_command",
      "params": [
        {
          "name": "cmd",
          "type": {
            "$ref": "Command"
          }
        },
        {
          "name": "label",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    {
      "name": "set_role",
      "params": [
        {
          "name": "role",
          "type": {
            "$ref": "Role"
          }
        }
      ]
    },
    {
      "name": "store_digest",
      "params": [
        {
          "name": "d",
          "type": {
            "$ref": "Digest"
          }
        }
      ]
    },
    {
      "name": "run_aliased_command",
      "params": [
        {
          "name": "cmd",
          "type": {
            "$ref": "AliasOfCommand"
          }
        }
      ]
    },
    {
      "name": "get_role",
      "params": [],
      "returns": {
        "$ref": "Role"
      }
    },
    {
      "name": "last_command",
      "params": [],
      "returns": {
        "$ref": "Command"
      }
    }
  ],
  "events": []
}
